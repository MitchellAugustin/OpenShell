set -eu

CANONICAL_CONFIG_FILE="${SNAP_COMMON}/gateway.toml"
CANONICAL_TLS_DIR="${SNAP_COMMON}/tls"
export OPENSHELL_DB_URL="${OPENSHELL_DB_URL:-sqlite:${SNAP_COMMON}/gateway.db?mode=rwc}"
export OPENSHELL_DISABLE_TLS="${OPENSHELL_DISABLE_TLS:-true}"
export OPENSHELL_LOCAL_TLS_DIR="${OPENSHELL_LOCAL_TLS_DIR:-$CANONICAL_TLS_DIR}"

if [ ! -f "$CANONICAL_CONFIG_FILE" ]; then
    umask 077
    cat >"$CANONICAL_CONFIG_FILE" <<EOF
[openshell]
version = 1

[openshell.gateway]
compute_drivers = ["docker"]

[openshell.gateway.gateway_jwt]
signing_key_path = "${CANONICAL_TLS_DIR}/jwt/signing.pem"
public_key_path  = "${CANONICAL_TLS_DIR}/jwt/public.pem"
kid_path         = "${CANONICAL_TLS_DIR}/jwt/kid"
gateway_id       = "openshell"
ttl_secs         = 0
EOF
fi

"${SNAP}/bin/openshell-gateway" generate-certs \
    --output-dir "$OPENSHELL_LOCAL_TLS_DIR" \
    --server-san host.openshell.internal

if [ -z "${OPENSHELL_GATEWAY_CONFIG:-}" ] && [ -f "$CANONICAL_CONFIG_FILE" ]; then
    exec "${SNAP}/bin/openshell-gateway" --config "$CANONICAL_CONFIG_FILE" "$@"
fi

exec "${SNAP}/bin/openshell-gateway" "$@"
